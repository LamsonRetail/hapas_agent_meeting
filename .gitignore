# ============================================================
#  V1 nam trong v1/, V2 trong v2/.
#
#  BAY DA GAP (o repo ca nhan truoc day): git KHONG ap dung ignore cho file DA
#  tracked. Vi vay jobs/ out/ minutes/ poller_state.json tuy co trong file nay
#  van bi commit suot (~30MB, gom ca file ghi hinh cuoc hop THAT), va
#  v1/config.bat bi commit kem secret tran.
#
#  Repo NAY khoi tao SACH, khong mang history do sang: khong co secret, khong
#  co ban ghi hop. Dung de tai dien — kiem `git status` truoc moi commit, va
#  nho: them vao .gitignore KHONG go tracking cho file da lo commit.
# ============================================================

# --- Secret ---------------------------------------------------
# KHONG BAO GIO commit config.bat that. Ban mau: v1/config.bat.example
v1/config.bat
config.bat
v1/users.json
v2/.env

# --- Du lieu runtime -----------------------------------------
v1/poller_state.json
v1/jobs/
v1/out/
v1/minutes/
v1/meeting_downloads/
v2/data/

# --- Python ---------------------------------------------------
__pycache__/
*.pyc

# Rac do go "> nul" trong bash (Windows: nul la device, bash tao thanh file that)
nul
