# ============================================================
#  Sau khi don 31/07/2026: V1 nam trong v1/, V2 trong v2/.
#
#  BAY DA GAP: git KHONG ap dung ignore cho file DA tracked. Vi vay
#  jobs/ out/ minutes/ poller_state.json tuy co trong file nay van bi commit
#  suot (~30MB, gom ca file ghi hinh cuoc hop THAT). Da `git rm --cached`
#  nen tu nay khong bi commit nua, NHUNG chung van con trong HISTORY.
#  Muon xoa khoi history phai rewrite (git filter-repo) + force push — CHUA LAM.
# ============================================================

# --- Secret ---------------------------------------------------
# v1/config.bat DANG BI TRACKED CO Y THUC (commit 985573f, repo private): trong
# do co OPENAI_API_KEY + SENDER_APP_SECRET dang tran. Ai duoc them vao repo la
# doc duoc, va no nam trong history vinh vien. Dong duoi KHONG go tracking —
# no chi giup nguoi clone ve khoi commit ban rieng cua ho.
v1/config.bat
v1/users.json
v2/.env

# --- Du lieu runtime -----------------------------------------
v1/poller_state.json
v1/jobs/
v1/out/
v1/minutes/
v1/meeting_downloads/
v2/data/

# Ban sao state.db + khoa Fernet (v2/backup.py). `v2/data/` o tren da phu cho
# duong dan mac dinh; ba dong nay de phong V2_BACKUP_DIR / V2_KEY_BACKUP_PATH
# bi tro vao mot cho KHAC trong repo. Mot ban state.db lot vao git la lo token
# cua ca cong ty (da ma hoa, nhung khoa nam ngay trong v2/.env cua may do).
backups/
state-*.db
fernet-key.txt

# --- Python ---------------------------------------------------
__pycache__/
*.pyc

# Rac do go "> nul" trong bash (Windows: nul la device, bash tao thanh file that)
nul

# File link enroll sinh tam (co nonce) - dung commit
enroll-links.html
# Hai dòng dưới do `vercel link` tự thêm (02/08/2026).
.vercel
.env*
# ...nhưng `.env*` khớp CẢ `v2/.env.example` — file mẫu mà repo cần có.
# Hôm nay nó vẫn còn vì đã được tracked từ trước (gitignore không đuổi file đã
# tracked), nên lỗi này vô hình: chỉ lộ ra vào ngày ai đó xoá rồi thêm lại, và
# lúc đó người mới clone về sẽ không có file mẫu nào để chép.
!.env.example
