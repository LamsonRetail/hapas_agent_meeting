# ============================================================
#  V2 orchestrator — mẫu cấu hình. Copy thành v2/.env rồi điền.
#  v2/.env đã nằm trong .gitignore — KHÔNG commit.
#  Biến môi trường thật (đã export) luôn thắng giá trị ở đây.
# ============================================================

# --- Lark app -------------------------------------------------
LARK_DOMAIN=lark
LARK_APP_ID=cli_aae288361ef89eed
LARK_APP_SECRET=

# OAuth: redirect_uri PHẢI khớp chính xác cái đăng ký trong Console.
# Test qua Vercel (đang dùng): https://<project>.vercel.app/oauth/callback
# Hoặc callback local:          http://localhost:8080/oauth/callback
OAUTH_REDIRECT_URI=https://<project>.vercel.app/oauth/callback

# Xin đủ scope ngay lần đầu (V2_LONGTERM §3.2) — thêm sau = MỌI người enroll
# lại. offline_access BẮT BUỘC phải có, nếu không endpoint token v2 KHÔNG trả
# refresh_token -> complete() sẽ lỗi 'refresh_token'.
#
# Dòng dưới là danh sách TỐI THIỂU: đúng những gì V2 gọi, không hơn. 18 scope.
# Sinh lại + kiểm: `python -m v2 scopes --print-all` rồi `python -m v2 scopes`.
#
# ⚠️ ĐỪNG quay lại "xin trọn họ" (đã thử 31/07, bỏ 01/08 — sổ tay §22). Bản đó
# xin 124 scope, kéo theo quyền GHI Docs, GHI Drive, xoá comment, đổi permission.
# Hai cái giá thật: người mới nhìn màn hình Đồng ý thì ngại bấm (đã gặp), và mất
# state.db + V2_FERNET_KEY lúc đó = mất cả tài khoản Lark của họ chứ không phải
# chỉ mất quyền đọc minutes.
#
# Nguồn sự thật là `scopecheck.SCOPES_NEEDED`, mỗi scope ứng MỘT lời gọi trong
# `scopecheck._checks()`. Thêm scope thì PHẢI thêm phép kiểm — không thì sau này
# không ai biết nó còn cần hay không, và đó đúng là cách danh sách phình lên 124.
OAUTH_SCOPES=offline_access minutes:minutes:readonly minutes:minutes.basic:read minutes:minutes.search:read minutes:minutes.media:export minutes:minutes.transcript:export calendar:calendar:readonly calendar:calendar:read calendar:calendar.event:read vc:meeting:readonly vc:record:readonly vc:recording:read contact:user.base:readonly contact:user.id:readonly contact:user.employee_id:readonly task:task:write task:task:read docs:document.media:upload

# --- Mã hóa token (BẮT BUỘC) ----------------------------------
# Sinh: python -m v2 genkey
V2_FERNET_KEY=

# --- Nơi lưu (mặc định v2/data) -------------------------------
# V2_DATA_DIR=

# --- Sao lưu tự động (sổ tay §6) ------------------------------
# Vòng `run` tự sao lưu state.db mỗi V2_BACKUP_EVERY_HOURS giờ, giữ N bản mới
# nhất. Mất state.db là mất CẢ token (enroll lại cả công ty) LẪN phân quyền hỏi
# đáp (qa.viewers_index dựng từ jobs.meta_json.attendees — không có job thì
# không ai chứng minh được mình có dự, nên không ai đọc được biên bản của chính
# mình). Xem v2/backup.py. 0 = tắt. Chạy tay: python -m v2 backup [--list]
V2_BACKUP_EVERY_HOURS=24
V2_BACKUP_KEEP=14
# V2_BACKUP_DIR=            # mặc định <V2_DATA_DIR>/backups
#
# ⚠️ Kiểm Ổ VẬT LÝ trước khi tin: nhiều ổ chữ cái khác nhau vẫn có thể là một ổ
# đĩa (máy gốc: C: D: E: đều là Disk #0). Cùng ổ = chống được xoá nhầm / DB
# hỏng, KHÔNG chống được chết ổ. Trỏ ra ngoài máy thì cân nhắc: bản sao chứa
# recap NỘI DUNG HỌP ở dạng đọc được, chỉ token là mã hóa.
#
# Khóa Fernet để RIÊNG CHỖ với DB: DB không key = rác, key không DB = rác, nên
# để chung một thư mục là bỏ luôn tác dụng của việc mã hóa. Mặc định
# %USERPROFILE%/.meetingxlark/fernet-key.txt (ngoài repo, ngoài data/).
# V2_KEY_BACKUP_PATH=

# --- Transcribe server (whisper server E:\whisper, dùng từ V1) -
# run-server.bat mặc định PORT=8000. Đổi ở đây nếu bạn đổi PORT.
TRANSCRIBE_URL=http://localhost:8000
TRANSCRIBE_LANG=vi

# --- LLM sinh recap (để trống -> chỉ gửi transcript) ----------
# Đổi provider chỉ bằng base_url (seam §4.2). Không cần đụng Console: tầng
# recap không chạm Lark, chỉ là một endpoint LLM.
#
# CÁCH ĐANG DÙNG (từ 31/07/2026, sổ tay §15): qua `api_server` của Hermes ->
# chạy bằng gói ChatGPT, không tiêu API key theo token. Điều kiện:
#   1. `.env` của Hermes có API_SERVER_KEY + API_SERVER_PORT=8642
#   2. LLM_API_KEY dưới đây PHẢI BẰNG API_SERVER_KEY đó (lệch -> 401)
#   3. gateway Hermes đang chạy (`doctor` gọi thử và báo [x] nếu tắt)
# LƯU Ý: `hermes proxy` KHÔNG dùng được — nó chỉ hỗ trợ upstream nous/xai,
# không có openai-codex. Và cổng là 8642, không phải 8600.
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:8642/v1
LLM_MODEL=hermes
LLM_JSON_MODE=0
LLM_TIMEOUT=240

# Cách cũ — OpenAI API trả tiền theo token. Bỏ comment 4 dòng dưới, comment 4
# dòng trên. Đo 31/07: cùng transcript, gpt-4o-mini ra 0 quyết định còn Hermes
# (gpt-5.6-sol) ra 1 -> model yếu CÓ bỏ sót. Nhưng V2_LONGTERM §3.3 vẫn lưu ý
# đường Hermes là một AGENT: kết quả không tái lập bằng, và lời nói trong họp
# chảy vào một tầng có tool (đã siết `platform_toolsets.api_server: [no_mcp]`).
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_JSON_MODE=1

# --- Hành vi poller ------------------------------------------
POLL_INTERVAL=300
# Quét lùi bao nhiêu ngày để BẮT BÙ — toàn bộ khả năng phục hồi sau gián đoạn.
# Máy tắt/ngủ lâu hơn ngần này = cuộc họp trong khoảng đó mất vĩnh viễn, im lặng.
LOOKBACK_DAYS=7
# Quét lùi bao nhiêu ngày MỘT LẦN, lúc một người vừa kết nối, để nạp backlog
# cuộc họp cũ của riêng họ. Trống = bằng LOOKBACK_DAYS (giữ nguyên hành vi cũ).
# Đặt 90 = ai kết nối cũng có sẵn 90 ngày, thay vì phải chạy `backfill` tay.
# ĐO TRƯỚC KHI ĐẶT:  python -m v2 coverage --days 90
# Cuộc mà CHỦ BẢN GHI chưa kết nối sẽ dừng ở waiting_auth dù có nạp về — Lark
# không đưa nội dung cho token nào khác. Xem v2/coverage.py.
# ENROLL_BACKFILL_DAYS=90
SETTLE_MINUTES=3
CAL_WINDOW_HOURS=3
FALLBACK_TO_OWNER=1

# Gọi LLM hỏng bao nhiêu lần LIÊN TIẾP thì thôi chờ và phát bản KHÔNG có recap
# (sổ tay §19). Trước 31/07/2026 không có ngưỡng nào vì lỗi LLM bị nuốt và phát
# ngay bản trống — một cú 429 lẻ là mất tóm tắt của cuộc họp đó vĩnh viễn.
# Trong lúc hoãn: KHÔNG tiêu MAX_ATTEMPTS, và KHÔNG phiên âm lại.
# 3 vòng ≈ 15 phút với POLL_INTERVAL=300.
RECAP_MAX_TRIES=3

# Không còn REQUIRE_APPROVAL / APPROVAL_TIMEOUT_HOURS: cửa duyệt đã bỏ
# (30/07/2026), họp xong là phát ngay tóm tắt + transcript cho mọi người trong
# sự kiện lịch của host. Hai lưới an toàn còn lại là SEND_MODE và PAUSED dưới đây.

# --- Cảnh báo qua Lark DM (sổ tay §17) ------------------------
# Hệ thống tự nhắn khi nó hỏng: job failed, whisper gọi không được, token sắp
# hết hạn. Mỗi tình huống chỉ báo MỘT lần cho tới khi tình trạng đổi.
# Danh sách union_id (dạng on_...), ngăn bằng dấu phẩy. TRỐNG = TẮT HẲN.
# Lấy union_id của mình:
#   sqlite3 v2\data\state.db "select name, union_id from tokens;"
ALERT_UNION_IDS=
# Whisper phải hỏng LIÊN TỤC ngần này phút mới DM (log thì in mỗi vòng).
ALERT_WHISPER_AFTER_MIN=15
# LLM (recap) hỏng liên tục ngần này phút thì DM. Hậu quả KHÁC whisper và tệ
# hơn: whisper chết thì job nằm chờ (không mất gì), LLM chết quá RECAP_MAX_TRIES
# vòng thì biên bản PHÁT ĐI với tóm tắt rỗng.
ALERT_LLM_AFTER_MIN=15
# Vòng `run` im quá ngần này phút thì báo. 0 = tắt.
# Phép kiểm DUY NHẤT chỉ chạy được từ NGOÀI vòng run (Task Scheduler gọi
# run-v2-alerts.bat) — vì mọi cảnh báo khác nằm BÊN TRONG chính vòng đó, nên nó
# chết là chúng im theo. Gấp hơn vẻ ngoài: refresh token Lark sống 7 NGÀY và
# được gia hạn bởi chính vòng `run`. Xem sổ tay §28.
ALERT_RUN_STALE_MIN=30

# --- Hỏi đáp: ai xem được biên bản nào (sổ tay §20) -----------
# Bot CHỈ trả về cuộc họp mà người hỏi có trong danh sách người dự, hoặc là chủ
# cuộc họp. Trước 31/07/2026 ai đã enroll cũng đọc được biên bản của cả nhà.
# Ai được xem TẤT CẢ (để chẩn lỗi). Để trống dòng này = lấy đúng ALERT_UNION_IDS.
# TRỐNG cả hai = KHÔNG ai là admin (fail-closed, không phải "mở hết").
QA_ADMIN_UNION_IDS=
# Vé phiên của người hỏi sống bao lâu (giây). Mỗi tin mới đều gia hạn, nên đây là
# "im lặng bao lâu thì phải xin vé mới", không phải giới hạn độ dài hội thoại.
QA_TOKEN_TTL=900

# --- Hồ sơ bot (v2/profile.py, 06/08/2026) -------------------
# Tên bot tự xưng khi có người hỏi "bạn là ai". Để trống = "Thư Ký".
# Chỉ là TÊN: phần mô tả việc làm được / luồng / giới hạn nằm trong
# `v2/profile.py` để nó được version-control và được selftest kiểm nội dung.
# Xem hồ sơ bot đang dùng:  python -m v2 profile
V2_BOT_NAME=

# --- Base "nội dung đã chốt" (draft/final) -------------------
# Lấy bằng: python -m v2 base-init  (in ra 3 lệnh lark-cli, chạy MỘT lần).
# Để trống = tắt; phát biên bản vẫn chạy bình thường, chỉ không lưu record.
# ĐỪNG để bot tự tạo Base: bot là chủ thì bạn không mở được và không xóa được.
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=

# --- Hỏi đáp về cuộc họp -------------------------------------
# KHÔNG có biến nào ở đây. Bot chat là Hermes: nó có app Lark riêng và cấu hình
# riêng trong ~/.hermes/ (FEISHU_APP_ID, FEISHU_DOMAIN=lark, mcp_servers...).
# V2 chỉ phơi dữ liệu: `python -m v2 mcp`. Xem docs/V2_MAINTENANCE.md §12.
# `python -m v2 ask "..."` dùng LLM_* ở trên để test không cần Hermes.

# An toàn: 0 = dry-run (không gửi). Đặt 1 hoặc dùng --send để gửi thật.
SEND_MODE=0
# Công tắc dừng khẩn.
PAUSED=0

# --- Dashboard trạng thái (local đẩy snapshot lên Vercel) -----
# Máy local ĐẨY snapshot đã ẩn danh; Vercel không bao giờ query về đây.
# Để trống STATUS_PUSH_URL = tắt hẳn dashboard.
# Secret phải khớp hai đầu:
#   cd v2/vercel-oauth && npx vercel env add STATUS_PUSH_SECRET production
STATUS_PUSH_URL=
STATUS_PUSH_SECRET=
# Giãn cách tối thiểu giữa 2 lần đẩy trong vòng `run` (giây). 0 = mỗi vòng.
STATUS_PUSH_EVERY=7200
STATUS_PUSH_TIMEOUT=15

# --- Hộp thư code OAuth (enroll tự phục vụ, sổ tay §14) --------
# Người mới nhắn bot -> bot gửi link -> họ bấm Đồng ý -> Vercel giữ {code,state}
# trong Blob -> V2 KÉO về và enroll, không ai phải dán code.
# Để trống = tắt (enroll quay về cách dán code bằng tay).
# Dùng chung bearer với dashboard (STATUS_PUSH_SECRET). Bỏ trống thì tự suy ra
# từ STATUS_PUSH_URL: <gốc>/api/oauth-pending
OAUTH_PULL_URL=

# --- Cloudflare OAuth relay (thay Vercel Blob, không chứa Lark app secret) ---
# Chạy lệnh tương tác để nhập token ẩn và kiểm tra quyền trước khi ghi:
#   python -m v2 cloudflare-config --account-id <32-hex> --queue-id <32-hex>
# CF_RELAY_URL chỉ điền SAU khi Worker deploy và ngay trước cutover được duyệt.
CF_RELAY_URL=
CF_ACCOUNT_ID=
CF_QUEUE_ID=
CF_QUEUE_API_TOKEN=
OAUTH_STATE_SECRET=
CF_QUEUE_TIMEOUT=20
CF_QUEUE_BATCH_SIZE=10
CF_QUEUE_VISIBILITY_SECONDS=120
CF_QUEUE_MAX_ATTEMPTS=5

# === V3 (docs/V3_SPECS.md) ==================================================
# --- YC1: chủ cuộc họp duyệt biên bản trước khi báo người dự ---
CONFIRM_ENABLED=1
CONFIRM_REMIND_HOURS=8
CONFIRM_TIMEOUT_HOURS=24

# --- YC2: biên bản .md + quyền theo chuỗi quản lý + Drive ---
# MẶC ĐỊNH TẮT: bật là đổi quyền xem / ghi ra ngoài. Thứ tự bật:
#   v2 org-sync -> v2 org-sync --yes -> ORG_SYNC_HOURS=24 -> v2 notes
#   v2 drive-provision -> (duyệt danh sách) -> --yes -> DRIVE_ENABLED=1 -> v2 notes
ORG_SYNC_HOURS=0
DRIVE_ENABLED=0
# Để TRỐNG (space riêng của bot). Đặt folder của người khác = họ thấy mọi biên bản.
DRIVE_ROOT_FOLDER=
V2_NOTES_DIR=

# --- YC3/YC4: LiteLLM của công ty (virtual key do thienlq cấp) ---
LITELLM_BASE_URL=https://litellm.hapas-ai.tech/v1
LITELLM_API_KEY=
EMBED_MODEL=text-embedding-3-small
DIGEST_MODEL=gpt-4o-mini
EMBED_PER_ROUND=5

# --- YC4: dashboard (python -m v2 dashboard / run-v2-dashboard.bat) ---
DASHBOARD_PORT=8765
DASHBOARD_HOSTS=meeting.lamsonretail.com,meeting.hapas-ai.tech
# Chuỗi ngẫu nhiên >= 32 ký tự, KHÔNG commit. Trống = dashboard không chạy.
DASHBOARD_SECRET=
DASHBOARD_SESSION_HOURS=12
