# ============================================================
#  V2 orchestrator — mẫu cấu hình. Copy thành v2/.env rồi điền.
#  v2/.env đã nằm trong .gitignore — KHÔNG commit.
#  Biến môi trường thật (đã export) luôn thắng giá trị ở đây.
# ============================================================

# --- Lark app -------------------------------------------------
LARK_DOMAIN=lark
LARK_APP_ID=cli_aae288361ef89eed
LARK_APP_SECRET=

# OAuth: redirect_uri PHẢI khớp chính xác cái đăng ký trong Console.
# Test qua Vercel (đang dùng): https://<project>.vercel.app/oauth/callback
# Hoặc callback local:          http://localhost:8080/oauth/callback
OAUTH_REDIRECT_URI=https://<project>.vercel.app/oauth/callback

# Xin đủ scope ngay lần đầu (V2_LONGTERM §3.2) — thêm sau = cả cty duyệt lại.
# Kiểm tra tên scope đúng với Console tenant của bạn trước khi publish.
# offline_access BẮT BUỘC phải có, nếu không endpoint token v2 KHÔNG trả
# refresh_token -> complete() sẽ lỗi 'refresh_token'.
OAUTH_SCOPES=offline_access minutes:minutes:readonly calendar:calendar:readonly vc:record:readonly contact:user.base:readonly task:task:write vc:meeting.meetingevent:read vc:meeting:readonly

# --- Mã hóa token (BẮT BUỘC) ----------------------------------
# Sinh: python -m v2 genkey
V2_FERNET_KEY=

# --- Nơi lưu (mặc định v2/data) -------------------------------
# V2_DATA_DIR=

# --- Transcribe server (whisper server E:\whisper, dùng từ V1) -
# run-server.bat mặc định PORT=8000. Đổi ở đây nếu bạn đổi PORT.
TRANSCRIBE_URL=http://localhost:8000
TRANSCRIBE_LANG=vi

# --- LLM sinh recap (để trống -> chỉ gửi transcript) ----------
# Đổi provider chỉ bằng base_url (seam §4.2). Không cần đụng Console: tầng
# recap không chạm Lark, chỉ là một endpoint LLM.
#
# CÁCH ĐANG DÙNG (từ 31/07/2026, sổ tay §15): qua `api_server` của Hermes ->
# chạy bằng gói ChatGPT, không tiêu API key theo token. Điều kiện:
#   1. `.env` của Hermes có API_SERVER_KEY + API_SERVER_PORT=8642
#   2. LLM_API_KEY dưới đây PHẢI BẰNG API_SERVER_KEY đó (lệch -> 401)
#   3. gateway Hermes đang chạy (`doctor` gọi thử và báo [x] nếu tắt)
# LƯU Ý: `hermes proxy` KHÔNG dùng được — nó chỉ hỗ trợ upstream nous/xai,
# không có openai-codex. Và cổng là 8642, không phải 8600.
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:8642/v1
LLM_MODEL=hermes
LLM_JSON_MODE=0
LLM_TIMEOUT=240

# Cách cũ — OpenAI API trả tiền theo token. Bỏ comment 4 dòng dưới, comment 4
# dòng trên. Đo 31/07: cùng transcript, gpt-4o-mini ra 0 quyết định còn Hermes
# (gpt-5.6-sol) ra 1 -> model yếu CÓ bỏ sót. Nhưng V2_LONGTERM §3.3 vẫn lưu ý
# đường Hermes là một AGENT: kết quả không tái lập bằng, và lời nói trong họp
# chảy vào một tầng có tool (đã siết `platform_toolsets.api_server: [no_mcp]`).
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_JSON_MODE=1

# --- Hành vi poller ------------------------------------------
POLL_INTERVAL=300
LOOKBACK_DAYS=2
SETTLE_MINUTES=3
CAL_WINDOW_HOURS=3
FALLBACK_TO_OWNER=1

# Không còn REQUIRE_APPROVAL / APPROVAL_TIMEOUT_HOURS: cửa duyệt đã bỏ
# (30/07/2026), họp xong là phát ngay tóm tắt + transcript cho mọi người trong
# sự kiện lịch của host. Hai lưới an toàn còn lại là SEND_MODE và PAUSED dưới đây.

# --- Cảnh báo qua Lark DM (sổ tay §17) ------------------------
# Hệ thống tự nhắn khi nó hỏng: job failed, whisper gọi không được, token sắp
# hết hạn. Mỗi tình huống chỉ báo MỘT lần cho tới khi tình trạng đổi.
# Danh sách union_id (dạng on_...), ngăn bằng dấu phẩy. TRỐNG = TẮT HẲN.
# Lấy union_id của mình:
#   sqlite3 v2\data\state.db "select name, union_id from tokens;"
ALERT_UNION_IDS=
# Whisper phải hỏng LIÊN TỤC ngần này phút mới DM (log thì in mỗi vòng).
ALERT_WHISPER_AFTER_MIN=15

# --- Base "nội dung đã chốt" (draft/final) -------------------
# Lấy bằng: python -m v2 base-init  (in ra 3 lệnh lark-cli, chạy MỘT lần).
# Để trống = tắt; phát biên bản vẫn chạy bình thường, chỉ không lưu record.
# ĐỪNG để bot tự tạo Base: bot là chủ thì bạn không mở được và không xóa được.
BITABLE_APP_TOKEN=
BITABLE_TABLE_ID=

# --- Hỏi đáp về cuộc họp -------------------------------------
# KHÔNG có biến nào ở đây. Bot chat là Hermes: nó có app Lark riêng và cấu hình
# riêng trong ~/.hermes/ (FEISHU_APP_ID, FEISHU_DOMAIN=lark, mcp_servers...).
# V2 chỉ phơi dữ liệu: `python -m v2 mcp`. Xem docs/V2_MAINTENANCE.md §12.
# `python -m v2 ask "..."` dùng LLM_* ở trên để test không cần Hermes.

# An toàn: 0 = dry-run (không gửi). Đặt 1 hoặc dùng --send để gửi thật.
SEND_MODE=0
# Công tắc dừng khẩn.
PAUSED=0

# --- Dashboard trạng thái (local đẩy snapshot lên Vercel) -----
# Máy local ĐẨY snapshot đã ẩn danh; Vercel không bao giờ query về đây.
# Để trống STATUS_PUSH_URL = tắt hẳn dashboard.
# Secret phải khớp hai đầu:
#   cd v2/vercel-oauth && npx vercel env add STATUS_PUSH_SECRET production
STATUS_PUSH_URL=
STATUS_PUSH_SECRET=
# Giãn cách tối thiểu giữa 2 lần đẩy trong vòng `run` (giây). 0 = mỗi vòng.
STATUS_PUSH_EVERY=0
STATUS_PUSH_TIMEOUT=15

# --- Hộp thư code OAuth (enroll tự phục vụ, sổ tay §14) --------
# Người mới nhắn bot -> bot gửi link -> họ bấm Đồng ý -> Vercel giữ {code,state}
# trong Blob -> V2 KÉO về và enroll, không ai phải dán code.
# Để trống = tắt (enroll quay về cách dán code bằng tay).
# Dùng chung bearer với dashboard (STATUS_PUSH_SECRET). Bỏ trống thì tự suy ra
# từ STATUS_PUSH_URL: <gốc>/api/oauth-pending
OAUTH_PULL_URL=
